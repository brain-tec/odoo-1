<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.product.configurator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <button string="Quote" name="action_frepple_quote" type="object"
                   class="oe_highlight"
                   confirm="This will send a quote request to frepple"
                   groups="frepple.frepple_quoting_user"
                   invisible="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
