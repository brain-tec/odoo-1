<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="frepple_recommendation_search" model="ir.ui.view">
        <field name="name">frepple.recommendation.search</field>
        <field name="model">frepple.recommendation</field>
        <field name="arch" type="xml">
                <search>
                    <field name="product_id" string="product"/>
                    <field name="related_data_id" string="related data"/>

                    <separator/>

                    <filter name="type_sales"
                            string="Sales recommendations"
                            domain="[('type','=','latedelivery')]"/>
                    <filter name="type_purchase"
                            string="Purchase recommendations"
                            domain="[('type','=','purchase')]"/>
                    <filter name="type_manufacturing"
                            string="Manufacturing recommendations"
                            domain="[('type','in',('produce','reschedule'))]"/>
            </search>
        </field>
    </record>

    <record id="frepple_recommendation_action_manufacturing" model="ir.actions.act_window">
        <field name="help" type="html">
            <div class="frepple_empty_state">
                <p class="o_view_nocontent_smiling_face">
                    Don't wait to <a type="object" name="action_generate_recommendations" class="o_link">generate</a> your first recommendations.
                </p>
                <p class="text-muted text-start">
                    FrePPLe will analyze the data in Odoo and will come up with recommendations.<br/>
                    Recommendations tell where the supply chain requires actions.<br/>
                </p>
                <div class="text-muted text-start d-inline-block">
                    Recommendations will identify:
                    <ul style="display: inline-block; text-align: left;">
                        <li>Manufacturing orders scheduled in the past</li>
                        <li>Manufacturing orders scheduled when a material is not available</li>
                        <li>Manufacturing orders scheduled when the work center is busy</li>
                        <li>Purchase or manufacturing orders that have to be created</li>
                        <li>Sales orders delivered late</li>
                    </ul>
                </div>
            </div>
        </field>
        <field name="name">FrePPLe recommendations</field>
        <field name="res_model">frepple.recommendation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                "search_default_type_manufacturing": 1
            }
        </field>
    </record>
