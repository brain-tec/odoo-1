<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="frepple_recommendation_action" model="ir.actions.act_window">
        <field name="name">FrePPLe recommendations</field>
        <field name="res_model">frepple.recommendation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="frepple_recommendation_view_form" model="ir.ui.view">
        <field name="name">Frepple Recommendations Form</field>
        <field name="model">frepple.recommendation</field>
        <field name="arch" type="xml">
            <form edit="0" create="0" delete="0">
                <group>
                    <group>
                        <field name="type" />
                        <field name="product_id" />
                        <field name="quantity" />
                        <field name="res_partner_id" />
                        <field name="sale_order_id" />
                        <field name="sale_order_line_id" />
                        <field name="mrp_production_id" />
                        <field name="description" />
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="frepple_recommendation_view_tree" model="ir.ui.view">
        <field name="name">FrePPLe Recommendations List</field>
        <field name="model">frepple.recommendation</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="type" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="startdate" optional="show"/>
                <field name="enddate" optional="show"/>
                <field name="quantity" />
                <field name="res_partner_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="sale_order_line_id" optional="show"/>
                <field name="mrp_production_id" optional="show"/>
                <field name="description" optional="show"/>

                <button name="action_approve"
                    string="Create Quote"
                    type="object"
                    class="btn-primary"
                    invisible="type != 'purchase'"/>

                <button name="action_approve"
                        string="Reschedule MO"
                        type="object"
                        class="btn-primary"
                        invisible="type != 'reschedule'"/>

                <button name="action_approve"
                        string="Create MO"
                        type="object"
                        class="btn-primary"
                        invisible="type != 'produce'"/>
            </list>
        </field>
    </record>
</odoo>
