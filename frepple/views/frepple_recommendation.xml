<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="frepple_recommendation_search" model="ir.ui.view">
        <field name="name">frepple.recommendation.search</field>
        <field name="model">frepple.recommendation</field>
        <field name="arch" type="xml">
            <search>
                <filter name="product_id"
                        string="product"/>
                <filter name="res_partner_id"
                        string="vendor"/>
                <filter name="sale_order_id"
                        string="sales order"/>
                <filter name="mrp_production_id"
                        string="manufacturing order"/>
                <filter name="type_sales"
                        string="Sales recommendations"
                        domain="[('type','=','latedelivery')]"/>
                <filter name="type_purchase"
                        string="Purchase recommendations"
                        domain="[('type','=','purchase')]"/>
                <filter name="type_manufacturing"
                        string="Manufacturing recommendations"
                        domain="[('type','in',('produce','reschedule'))]"/>
            </search>
        </field>
    </record>

    <record id="frepple_recommendation_action_manufacturing" model="ir.actions.act_window">
        <field name="name">FrePPLe recommendations</field>
        <field name="res_model">frepple.recommendation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                "search_default_type_manufacturing": 1
            }
        </field>
    </record>
    <record id="frepple_recommendation_action_purchase" model="ir.actions.act_window">
        <field name="name">FrePPLe recommendations</field>
        <field name="res_model">frepple.recommendation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                "search_default_type_purchase": 1
            }
        </field>
    </record>
    <record id="frepple_recommendation_action_sales" model="ir.actions.act_window">
        <field name="name">FrePPLe recommendations</field>
        <field name="res_model">frepple.recommendation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                "search_default_type_sales": 1
            }
        </field>
    </record>

    <record id="frepple_recommendation_view_tree" model="ir.ui.view">
        <field name="name">FrePPLe Recommendations List</field>
        <field name="model">frepple.recommendation</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" editable="bottom">
                <header>
                    <button name="action_generate_recommendations"
                            string="Generate Recommendations"
                            type="object"
                            class="oe_highlight"
                            display="always"/>
                </header>
                <button name="action_approve"
                    string="Create Quote"
                    type="object"
                    class="btn-primary"
                    invisible="type != 'purchase'"/>

                <button name="action_approve"
                        string="Reschedule MO"
                        type="object"
                        class="btn-primary"
                        invisible="type != 'reschedule'"/>

                <button name="action_approve"
                        string="Create MO"
                        type="object"
                        class="btn-primary"
                        invisible="type != 'produce'"/>

                <field name="recommendation" optional="show" readonly="1"/>
                <field name="type" readonly="1"/>
                <field name="product_id" readonly="1" widget="many2one"/>
                <field name="quantity" />
                    <button name="action_open_forecast"
                type="object"
                icon="fa-area-chart"
                title="Forecast"
                invisible="not product_id"/>
                <field name="startdate" optional="show"/>
                <field name="enddate" optional="show"/>
                <field name="res_partner_id" optional="show"/>
                <field name="sale_order_id" optional="show" readonly="1" widget="many2one"/>
                <field name="sale_order_line_id" optional="show" readonly="1" widget="many2one"/>
                <field name="mrp_production_id" optional="show" readonly="1" widget="many2one"/>
            </list>
        </field>
    </record>

    <record id="action_server_bulk_approve" model="ir.actions.server">
        <field name="name">Approve Recommendations</field>
        <field name="model_id" ref="model_frepple_recommendation"/>
        <field name="binding_model_id" ref="model_frepple_recommendation"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            records.action_approve()
        </field>
    </record>
</odoo>
