<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Extra configuration fields on the company form -->
    <record id="company_form_frepple" model="ir.ui.view">
      <field name="name">res.company.view.form</field>
      <field name="model">res.company</field>
      <field name="inherit_id" ref="base.view_company_form"/>
      <field name="priority">55</field>
      <field name="arch" type="xml">
        <xpath expr="//page[1]" position="after">
          <page string="FrePPLe">
            <group>
              <field name="calendar"/>
              <field name="manufacturing_warehouse"/>
              <field name="webtoken_key"/>
              <field name="frepple_server"/>
              <field name="disclose_stack_trace"/>
            </group>
          </page>
        </xpath>
      </field>
    </record>


    <!-- Needed when upgrading your module from the old frepple menu
    to the new one. -->
    <data>
      <delete model="ir.ui.menu" search="[('id', '=', ref('frepple.menu_frepple_web', False))]"/>
      <delete model="ir.ui.menu" search="[('id', '=', ref('frepple.menu_frepple_web_procurement', False))]"/>
      <delete model="ir.ui.menu" search="[('id', '=', ref('frepple.menu_frepple_planeditor', False))]"/>
      <delete model="ir.ui.menu" search="[('id', '=', ref('frepple.menu_frepple_forecast_editor', False))]"/>
      <delete model="ir.ui.menu" search="[('id', '=', ref('frepple.menu_frepple_inventoryplanning', False))]"/>
      <delete model="ir.actions.client" search="[('id', '=', ref('frepple.action_frepple_web', False))]"/>
    </data>
    <!-- end of migration -->

    <record id="action_frepple_web" model="ir.actions.server">
      <field name="name">Frepple</field>
      <field name="model_id" ref="base.model_res_company"/>
      <field name="state">code</field>
      <field name="code">
          action = model.actionOpenFreppleWindow()
      </field>
    </record>

    <!-- frePPLe UI in manufacturing menu. -->
    <menuitem
    id="menu_frepple_root_manufacturing"
    name="frePPLe"
    parent="mrp.menu_mrp_root"
    sequence="110"
    groups="frepple_user"/>

    <menuitem
    id="menu_frepple_web_manufacturing"
    name="FrePPLe APS"
    parent="menu_frepple_root_manufacturing"
    action="action_frepple_web"
    sequence="10"
    groups="frepple_user"/>

    <menuitem
    id="menu_frepple_recommendations_manufacturing"
    name="Recommendations"
    parent="menu_frepple_root_manufacturing"
    action="frepple_recommendation_action_manufacturing"
    sequence="20"
    groups="frepple_user"/>


    <!-- frePPLe UI in purchasing menu. -->

  <menuitem
    id="menu_frepple_root_purchase"
    name="frePPLe"
    parent="purchase.menu_purchase_root"
    sequence="110"
    groups="frepple_user"/>

    <menuitem
    id="menu_frepple_web_purchase"
    name="FrePPLe APS"
    parent="menu_frepple_root_purchase"
    action="action_frepple_web"
    sequence="10"
    groups="frepple_user"/>

    <menuitem
    id="menu_frepple_recommendations_purchase"
    name="Recommendations"
    parent="menu_frepple_root_purchase"
    action="frepple_recommendation_action_purchase"
    sequence="20"
    groups="frepple_user"/>



    <!-- frePPLe UI in sales menu. -->

    <menuitem
    id="menu_frepple_root_sales"
    name="frePPLe"
    parent="sale.sale_menu_root"
    sequence="110"
    groups="frepple_user"/>

    <menuitem
    id="menu_frepple_web_sales"
    name="FrePPLe APS"
    parent="menu_frepple_root_sales"
    action="action_frepple_web"
    sequence="10"
    groups="frepple_user"/>

    <menuitem
    id="menu_frepple_recommendations_sales"
    name="Recommendations"
    parent="menu_frepple_root_sales"
    action="frepple_recommendation_action_sales"
    sequence="20"
    groups="frepple_user"/>

  </data>
</odoo>
