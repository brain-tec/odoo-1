<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="frepple.RecommendationBanner">
        <div class="alert alert-primary d-flex align-items-center justify-content-between p-2 mx-3 mt-2 mb-0">
            <div class="d-flex align-items-center">
                <i class="fa fa-refresh fa-spin me-2 text-primary"/>
                <strong>FrePPLe Live:</strong>
                <span class="ms-1"><t t-esc="state.message"/></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-primary btn-sm" t-on-click="onButtonClick">
                    <i class="fa fa-bolt me-1"/>
                    Generate recommendations
                </button>
            </div>
        </div>
    </t>

    <t t-name="frepple.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <FreppleRecommendationBanner/>
        </xpath>
    </t>
</templates>
