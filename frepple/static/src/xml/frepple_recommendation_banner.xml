<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="frepple.RecommendationBanner">
        <div class="alert alert-primary d-flex align-items-center justify-content-between p-2 mx-3 mt-2 mb-0">
            <div class="d-flex align-items-center">
                <i class="fa fa-refresh fa-spin me-2 text-primary"/>
                <strong>FrePPLe Live:</strong>
                <span class="ms-1"><t t-esc="state.message"/></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button t-attf-class="btn btn-sm #{state.isRunning ? 'btn-danger' : 'btn-primary'}"
                        t-on-click="onButtonClick">
                    <i t-attf-class="fa me-1 #{state.isRunning ? 'fa-times' : 'fa-bolt'}"/>

                    <t t-if="state.isRunning">
                        Cancel job
                    </t>
                    <t t-else="">
                        Generate recommendations
                    </t>
                </button>
            </div>
        </div>
    </t>

    <t t-name="frepple.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <FreppleRecommendationBanner list="model.root"/>
        </xpath>
    </t>
</templates>
