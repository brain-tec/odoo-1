<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ========================================================= -->
    <!-- MAIN DASHBOARD                                            -->
    <!-- ========================================================= -->
    <t t-name="frepple.RecommendationDashboard">
        <div class="o_form_view o_form_nosheet">

            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-muted">
                    Recommendation generated on:
                    <t t-if="state.lastRunDate">
                        <t t-esc="this.formatDate(state.lastRunDate)"/>
                    </t>
                    <t t-else="">—</t>
                </span>

                <button type="button"
                        class="btn btn-primary btn-sm ms-2"
                        t-on-click="() => this.refreshRecommendations()"
                        title="Recompute recommendations">
                    <t t-if="state.hasRunningJob">Cancel</t>
                    <t t-else="">Recompute</t>
                </button>

            </div>

            <!-- ===================== -->
            <!-- TABS HEADER           -->
            <!-- ===================== -->
            <ul class="nav nav-tabs o_notebook">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#purchase">
                        Purchase (<t t-esc="state.pagination.purchase.total"/>)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#mrp">
                        Manufacturing (<t t-esc="state.pagination.mrp.total"/>)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#sale">
                        Sales (<t t-esc="state.pagination.sale.total"/>)
                    </a>
                </li>
                <!--
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#stock">
                        Inventory (<t t-esc="state.stock.length"/>)
                    </a>
                </li>
                -->
            </ul>

            <!-- ===================== -->
            <!-- BULK ACTION BAR       -->
            <!-- ===================== -->
            <div class="my-2">
                <button type="button"
                        class="btn btn-primary"
                        t-att-disabled="!state.selected.size"
                        t-on-click="() => this.bulkApprove()">
                    Approve selected (<t t-esc="state.selected.size"/>)
                </button>
            </div>

            <!-- ===================== -->
            <!-- TABS CONTENT          -->
            <!-- ===================== -->
            <div class="tab-content o_notebook_content">

                <!-- PURCHASE -->
                <div class="tab-pane fade show active" id="purchase">
                    <div class="o_tab_scroll">
                        <t t-call="frepple.RecommendationTable">
                            <t t-set="tabName" t-value="'purchase'"/>
                            <t t-set="records" t-value="state.purchase"/>
                            <t t-set="showManufacturingOrder" t-value="false"/>
                            <t t-set="showSalesOrder" t-value="false"/>
                            <t t-set="showPartner" t-value="true"/>
                            <t t-set="showApprove" t-value="true"/>
                            <t t-set="labels"
                            t-value="{
                                product: 'Product',
                                partner: 'Vendor',
                                quantity: 'Qty',
                                start: 'Ordering Date',
                                end: 'Receipt Date',
                                description: 'Description'
                            }"/>
                        </t>
                    </div>

                    <t t-if="Math.ceil(state.pagination.purchase.total / state.pagination.purchase.pageSize) > 1">
                        <div class="d-flex justify-content-center align-items-center gap-3 mt-2">

                            <!-- LEFT ARROW -->
                            <a href="#"
                            t-if="state.pagination.purchase.page &gt; 1"
                            class="text-primary"
                            t-att-class="state.pagination.purchase.page &lt;= 1 ? 'text-muted disabled' : ''"
                            t-on-click.prevent="() => this.prevPage('purchase')"
                            title="Previous page">
                                <i class="fa fa-chevron-left"/>
                            </a>

                            <!-- PAGE COUNTER -->
                            <span class="fw-semibold">
                                Page
                                <t t-esc="state.pagination.purchase.page"/>
                                /
                                <t t-esc="Math.ceil(state.pagination.purchase.total / state.pagination.purchase.pageSize)"/>
                            </span>

                            <!-- RIGHT ARROW -->
                            <a href="#"
                            t-if="state.pagination.purchase.page &lt; Math.ceil(state.pagination.purchase.total / state.pagination.purchase.pageSize)"
                            class="text-primary"
                            t-att-class="state.pagination.purchase.page &gt;= Math.ceil(state.pagination.purchase.total / state.pagination.purchase.pageSize) ? 'text-muted disabled' : ''"
                            t-on-click.prevent="() => this.nextPage('purchase')"
                            title="Next page">
                                <i class="fa fa-chevron-right"/>
                            </a>

                        </div>
                    </t>
                </div>

                <!-- MANUFACTURING -->
                <div class="tab-pane fade" id="mrp">
                    <div class="o_tab_scroll">
                        <t t-call="frepple.RecommendationTable">
                            <t t-set="tabName" t-value="'mrp'"/>
                            <t t-set="records" t-value="state.mrp"/>
                            <t t-set="showManufacturingOrder" t-value="true"/>
                            <t t-set="showSalesOrder" t-value="false"/>
                            <t t-set="showPartner" t-value="false"/>
                            <t t-set="showApprove" t-value="true"/>
                            <t t-set="labels"
                            t-value="{
                                product: 'Product',
                                mrp_production: 'Manufacturing Order',
                                quantity: 'Qty',
                                start: 'Start Date',
                                end: 'End Date',
                                description: 'Description'
                            }"/>
                        </t>
                    </div>

                    <t t-if="Math.ceil(state.pagination.mrp.total / state.pagination.mrp.pageSize) > 1">
                        <div class="d-flex justify-content-center align-items-center gap-3 mt-2">

                            <!-- LEFT ARROW -->
                            <a href="#"
                            t-if="state.pagination.mrp.page &gt; 1"
                            class="text-primary"
                            t-att-class="state.pagination.mrp.page &lt;= 1 ? 'text-muted disabled' : ''"
                            t-on-click.prevent="() => this.prevPage('mrp')"
                            title="Previous page">
                                <i class="fa fa-chevron-left"/>
                            </a>

                            <!-- PAGE COUNTER -->
                            <span class="fw-semibold">
                                Page
                                <t t-esc="state.pagination.mrp.page"/>
                                /
                                <t t-esc="Math.ceil(state.pagination.mrp.total / state.pagination.mrp.pageSize)"/>
                            </span>

                            <!-- RIGHT ARROW -->
                            <a href="#"
                            t-if="state.pagination.mrp.page &lt; Math.ceil(state.pagination.mrp.total / state.pagination.mrp.pageSize)"
                            class="text-primary"
                            t-att-class="state.pagination.mrp.page &gt;= Math.ceil(state.pagination.mrp.total / state.pagination.mrp.pageSize) ? 'text-muted disabled' : ''"
                            t-on-click.prevent="() => this.nextPage('mrp')"
                            title="Next page">
                                <i class="fa fa-chevron-right"/>
                            </a>

                        </div>
                    </t>
                </div>

                <!-- SALES -->
                <div class="tab-pane fade" id="sale">
                    <div class="o_tab_scroll">
                        <t t-call="frepple.RecommendationTable">
                            <t t-set="tabName" t-value="'sale'"/>
                            <t t-set="records" t-value="state.sale"/>
                            <t t-set="showManufacturingOrder" t-value="false"/>
                            <t t-set="showSalesOrder" t-value="true"/>
                            <t t-set="showPartner" t-value="false"/>
                            <t t-set="showApprove" t-value="false"/>
                            <t t-set="labels"
                            t-value="{
                                product: 'Product',
                                quantity: 'Qty',
                                sale_order: 'Sales Order',
                                start: 'Due Date',
                                end: 'Delivery Date',
                                description: 'Description'
                            }"/>
                        </t>
                    </div>

                    <t t-if="Math.ceil(state.pagination.sale.total / state.pagination.sale.pageSize) > 1">
                        <div class="d-flex justify-content-center align-items-center gap-3 mt-2">

                            <!-- LEFT ARROW -->
                            <a href="#"
                            t-if="state.pagination.sale.page &gt; 1"
                            class="text-primary"
                            t-att-class="state.pagination.sale.page &lt;= 1 ? 'text-muted disabled' : ''"
                            t-on-click.prevent="() => this.prevPage('sale')"
                            title="Previous page">
                                <i class="fa fa-chevron-left"/>
                            </a>

                            <!-- PAGE COUNTER -->
                            <span class="fw-semibold">
                                Page
                                <t t-esc="state.pagination.sale.page"/>
                                /
                                <t t-esc="Math.ceil(state.pagination.sale.total / state.pagination.sale.pageSize)"/>
                            </span>

                            <!-- RIGHT ARROW -->
                            <a href="#"
                            t-if="state.pagination.sale.page &lt; Math.ceil(state.pagination.sale.total / state.pagination.sale.pageSize)"
                            class="text-primary"
                            t-att-class="state.pagination.sale.page &gt;= Math.ceil(state.pagination.sale.total / state.pagination.sale.pageSize) ? 'text-muted disabled' : ''"
                            t-on-click.prevent="() => this.nextPage('sale')"
                            title="Next page">
                                <i class="fa fa-chevron-right"/>
                            </a>

                        </div>
                    </t>
                </div>

                <!-- INVENTORY
                <div class="tab-pane fade" id="stock">
                    <t t-call="frepple.RecommendationTable">
                        <t t-set="records" t-value="state.stock"/>
                        <t t-set="showManufacturingOrder" t-value="false"/>
                        <t t-set="showSalesOrder" t-value="true"/>
                        <t t-set="showPartner" t-value="false"/>
                        <t t-set="showApprove" t-value="false"/>
                        <t t-set="labels"
                           t-value="{
                               product: 'Product',
                               description: 'Description'
                           }"/>
                    </t>
                </div>
                -->

            </div>
        </div>
    </t>

    <!-- ========================================================= -->
    <!-- REUSABLE TABLE                                            -->
    <!-- ========================================================= -->
    <t t-name="frepple.RecommendationTable">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <!-- Checkbox column -->
                    <th style="width: 32px;">
                        <input type="checkbox"
                            class="form-check-input"
                            t-att-checked="this.areAllSelected(records)"
                            t-on-click.stop="() => this.toggleSelectAll(records)"
                        />
                    </th>

                    <th t-if="showManufacturingOrder">
                        <t t-esc="labels.mrp_production"/>
                    </th>

                    <th t-if="showSalesOrder">
                        <t t-esc="labels.sale_order"/>
                    </th>

                    <th><t t-esc="labels.product"/></th>

                    <th t-if="showPartner">
                        <t t-esc="labels.partner"/>
                    </th>

                    <th><t t-esc="labels.quantity"/></th>
                    <th><t t-esc="labels.start"/></th>
                    <th><t t-esc="labels.end"/></th>
                    <th><t t-esc="labels.description"/></th>

                    <th t-if="showApprove" style="width: 90px;"></th>
                </tr>
            </thead>

            <tbody>
                <t t-foreach="records" t-as="r" t-key="r.id">
                    <tr>
                        <!-- Selection checkbox -->
                        <td>
                            <input type="checkbox"
                              class="form-check-input"
                              t-att-checked="this.isSelected(r.id)"
                              t-on-click.stop="() => this.toggleSelection(r.id)"/>
                        </td>

                        <!-- MANUFACTURING ORDER -->
                        <td t-if="showManufacturingOrder">
                            <t t-esc="r.mrp_production_id?. [1] or ''"/>
                            <a t-if="r.mrp_production_id"
                               href="#"
                               class="ms-1 text-muted"
                               t-att-title="r.mrp_production_id?. [1] or 'View manufacturing order'"
                               t-on-click.prevent="() => this.openManufacturingOrder(r.mrp_production_id[0])">
                                <i class="fa fa-external-link me-1"/>
                            </a>
                        </td>

                        <!-- SALES ORDER -->
                        <td t-if="showSalesOrder">
                            <t t-esc="r.sale_order_id?. [1] or ''"/>
                            <a t-if="r.sale_order_id"
                               href="#"
                               class="ms-1 text-muted"
                               t-att-title="r.sale_order_id?. [1] or 'View sales order'"
                               t-on-click.prevent="() => this.openSalesOrder(r.sale_order_id[0])">
                                <i class="fa fa-external-link me-1"/>
                            </a>
                        </td>

                        <!-- PRODUCT -->
                        <td class="o_many2one_cell">
                            <t t-if="r.product_id">
                                <span><t t-esc="r.product_id?. [1] or ''"/></span>
                                <a href="#"
                                   class="ms-1 text-muted"
                                   t-att-title="r.product_id?. [1] or 'View product'"
                                   t-on-click.prevent="() => this.openProduct(r.product_id[0])">
                                    <i class="fa fa-external-link me-1"/>
                                </a>
                            </t>
                        </td>

                        <!-- SUPPLIER -->
                        <td t-if="showPartner">
                            <t t-esc="r.res_partner_id?. [1] or ''"/>
                            <a t-if="r.res_partner_id"
                               href="#"
                               class="ms-1 text-muted"
                               t-att-title="r.res_partner_id?. [1] or 'View vendor'"
                               t-on-click.prevent="() => this.openPartner(r.res_partner_id[0])">
                                <i class="fa fa-external-link me-1"/>
                            </a>
                        </td>

                        <!-- OTHER FIELDS -->
                        <td><t t-esc="r.quantity"/></td>
                        <td><t t-esc="r.startdate"/></td>
                        <td><t t-esc="r.enddate"/></td>
                        <td class="o_reco_description">
                            <t t-out="formatDescription(r.description)"/>
                        </td>

                        <!-- APPROVE BUTTON -->
                        <td t-if="showApprove">
                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    t-on-click.prevent="() => this.approveRecommendation(r.id)">
                                Approve
                            </button>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>

</templates>
