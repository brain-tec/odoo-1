<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ========================================================= -->
    <!-- MAIN DASHBOARD                                            -->
    <!-- ========================================================= -->
    <t t-name="frepple.RecommendationDashboard">
        <div class="o_form_view o_form_nosheet">

            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-muted">
                    Recommendation generated on:
                    <t t-if="state.lastRunDate">
                        <t t-esc="this.formatDate(state.lastRunDate)"/>
                    </t>
                    <t t-else="">—</t>
                </span>

                <button type="button"
                        class="btn btn-primary btn-sm ms-2"
                        t-on-click="() => this.refreshRecommendations()"
                        title="Recompute recommendations">
                    <t t-if="state.hasRunningJob">Cancel</t>
                    <t t-else="">Recompute</t>
                </button>
            </div>

            <!-- ===================== -->
            <!-- TABS HEADER           -->
            <!-- ===================== -->
            <ul class="nav nav-tabs o_notebook">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#purchase">
                        Purchase (<t t-esc="state.pagination.purchase.total"/>)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#mrp">
                        Manufacturing (<t t-esc="state.pagination.mrp.total"/>)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#sale">
                        Sales (<t t-esc="state.pagination.sale.total"/>)
                    </a>
                </li>
            </ul>

            <div class="my-2">
                <button type="button"
                        class="btn btn-primary"
                        t-att-disabled="!state.selected.size"
                        t-on-click="() => this.bulkApprove()">
                    Approve selected (<t t-esc="state.selected.size"/>)
                </button>
            </div>

            <!-- ===================== -->
            <!-- TABS CONTENT          -->
            <!-- ===================== -->
            <div class="tab-content o_notebook_content">

                <!-- PURCHASE -->
                <div class="tab-pane fade show active" id="purchase">
                    <div class="o_tab_scroll">
                        <t t-call="frepple.RecommendationTable">
                            <t t-set="tabName" t-value="'purchase'"/>
                            <t t-set="records" t-value="state.purchase"/>
                            <t t-set="showManufacturingOrder" t-value="false"/>
                            <t t-set="showSalesOrder" t-value="false"/>
                            <t t-set="showPartner" t-value="true"/>
                            <t t-set="showApprove" t-value="true"/>
                            <t t-set="labels" t-value="{
                                product: 'Product',
                                partner: 'Vendor',
                                quantity: 'Quantity',
                                start: 'Ordering Date',
                                end: 'Receipt Date',
                                description: 'Description'
                            }"/>
                        </t>
                    </div>
                    <t t-call="frepple.RecommendationPagination"><t t-set="tab" t-value="'purchase'"/></t>
                </div>

                <!-- MANUFACTURING -->
                <div class="tab-pane fade" id="mrp">
                    <div class="o_tab_scroll">
                        <t t-call="frepple.RecommendationTable">
                            <t t-set="tabName" t-value="'mrp'"/>
                            <t t-set="records" t-value="state.mrp"/>
                            <t t-set="showManufacturingOrder" t-value="true"/>
                            <t t-set="showSalesOrder" t-value="false"/>
                            <t t-set="showPartner" t-value="false"/>
                            <t t-set="showApprove" t-value="true"/>
                            <t t-set="labels" t-value="{
                                product: 'Product',
                                mrp_production: 'Manufacturing Order',
                                quantity: 'Quantity',
                                start: 'Start Date',
                                end: 'End Date',
                                description: 'Description'
                            }"/>
                        </t>
                    </div>
                    <t t-call="frepple.RecommendationPagination"><t t-set="tab" t-value="'mrp'"/></t>
                </div>

                <!-- SALES -->
                <div class="tab-pane fade" id="sale">
                    <div class="o_tab_scroll">
                        <t t-call="frepple.RecommendationTable">
                            <t t-set="tabName" t-value="'sale'"/>
                            <t t-set="records" t-value="state.sale"/>
                            <t t-set="showManufacturingOrder" t-value="false"/>
                            <t t-set="showSalesOrder" t-value="true"/>
                            <t t-set="showPartner" t-value="false"/>
                            <t t-set="showApprove" t-value="false"/>
                            <t t-set="labels" t-value="{
                                product: 'Product',
                                quantity: 'Quantity',
                                sale_order: 'Sales Order',
                                start: 'Due Date',
                                end: 'Delivery Date',
                                description: 'Description'
                            }"/>
                        </t>
                    </div>
                    <t t-call="frepple.RecommendationPagination"><t t-set="tab" t-value="'sale'"/></t>
                </div>
            </div>
        </div>
    </t>

    <!-- ========================================================= -->
    <!-- REUSABLE TABLE                                            -->
    <!-- ========================================================= -->
    <t t-name="frepple.RecommendationTable">
        <div class="o_list_view">
            <table class="table table-sm table-hover o_list_table" style="table-layout: fixed; width: 100%;">
                <thead>
                    <t t-set="tabSort" t-value="state.pagination[tabName]"/>
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" class="form-check-input"
                                   t-att-checked="this.areAllSelected(records)"
                                   t-on-click.stop="() => this.toggleSelectAll(records)"/>
                        </th>

                        <th t-if="showManufacturingOrder" style="width: 150px;" class="o_column_sortable"
                            t-att-class="tabSort.sortField == 'mrp_production_id' ? (tabSort.sortAsc ? 'o_order_asc' : 'o_order_desc') : ''"
                            t-on-click="() => this.setSort(tabName, 'mrp_production_id')">
                            <t t-esc="labels.mrp_production"/>
                        </th>

                        <th t-if="showSalesOrder" style="width: 150px;" class="o_column_sortable"
                            t-att-class="tabSort.sortField == 'sale_order_id' ? (tabSort.sortAsc ? 'o_order_asc' : 'o_order_desc') : ''"
                            t-on-click="() => this.setSort(tabName, 'sale_order_id')">
                            <t t-esc="labels.sale_order"/>
                        </th>

                        <th style="width: 200px;" class="o_column_sortable"
                            t-att-class="tabSort.sortField == 'product_id' ? (tabSort.sortAsc ? 'o_order_asc' : 'o_order_desc') : ''"
                            t-on-click="() => this.setSort(tabName, 'product_id')">
                            <t t-esc="labels.product"/>
                        </th>

                        <th t-if="showPartner" style="width: 150px;" class="o_column_sortable"
                            t-att-class="tabSort.sortField == 'res_partner_id' ? (tabSort.sortAsc ? 'o_order_asc' : 'o_order_desc') : ''"
                            t-on-click="() => this.setSort(tabName, 'res_partner_id')">
                            <t t-esc="labels.partner"/>
                        </th>

                        <th style="width: 80px;" class="o_column_sortable o_list_number"
                            t-att-class="tabSort.sortField == 'quantity' ? (tabSort.sortAsc ? 'o_order_asc' : 'o_order_desc') : ''"
                            t-on-click="() => this.setSort(tabName, 'quantity')">
                            <t t-esc="labels.quantity"/>
                        </th>

                        <th style="width: 160px;" class="o_column_sortable"
                            t-att-class="tabSort.sortField == 'startdate' ? (tabSort.sortAsc ? 'o_order_asc' : 'o_order_desc') : ''"
                            t-on-click="() => this.setSort(tabName, 'startdate')">
                            <t t-esc="labels.start"/>
                        </th>

                        <th style="width: 160px;" class="o_column_sortable"
                            t-att-class="tabSort.sortField == 'enddate' ? (tabSort.sortAsc ? 'o_order_asc' : 'o_order_desc') : ''"
                            t-on-click="() => this.setSort(tabName, 'enddate')">
                            <t t-esc="labels.end"/>
                        </th>

                        <th style="width: auto;"><t t-esc="labels.description"/></th>

                        <th t-if="showApprove" style="width: 100px;"></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="records" t-as="r" t-key="r.id">
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input"
                                  t-att-checked="this.isSelected(r.id)"
                                  t-on-click.stop="() => this.toggleSelection(r.id)"/>
                            </td>
                            <!-- MANUFACTURING ORDER -->
                            <td t-if="showManufacturingOrder" class="text-truncate">
                                <t t-esc="r.mrp_production_id ? r.mrp_production_id[1] : ''"/>
                                <a t-if="r.mrp_production_id" href="#" class="ms-1 text-muted"
                                   t-on-click.prevent="() => this.openManufacturingOrder(r.mrp_production_id[0])">
                                    <i class="fa fa-external-link me-1"/>
                                </a>
                            </td>
                            <!-- SALES ORDER -->
                            <td t-if="showSalesOrder" class="text-truncate">
                                <t t-esc="r.sale_order_id ? r.sale_order_id[1] : ''"/>
                                <a t-if="r.sale_order_id" href="#" class="ms-1 text-muted"
                                   t-on-click.prevent="() => this.openSalesOrder(r.sale_order_id[0])">
                                    <i class="fa fa-external-link me-1"/>
                                </a>
                            </td>
                            <!-- PRODUCT -->
                            <td class="reco_data_cell"> <t t-if="r.product_id">
                                    <div class="d-flex align-items-center w-100">
                                        <span class="text-truncate flex-grow-1" t-att-title="r.product_id[1]">
                                            <t t-esc="r.product_id[1]"/>
                                        </span>
                                        <a href="#" class="ms-1 text-muted flex-shrink-0"
                                        t-on-click.prevent="() => this.openProduct(r.product_id[0])">
                                            <i class="fa fa-external-link"/>
                                        </a>
                                    </div>
                                </t>
                            </td>
                            <!-- SUPPLIER -->
                            <td t-if="showPartner" class="reco_data_cell"> <t t-if="r.res_partner_id">
                                    <div class="d-flex align-items-center w-100">
                                        <span class="text-truncate flex-grow-1" t-att-title="r.res_partner_id[1]">
                                            <t t-esc="r.res_partner_id[1]"/>
                                        </span>
                                        <a href="#" class="ms-1 text-muted flex-shrink-0"
                                        t-on-click.prevent="() => this.openPartner(r.res_partner_id[0])">
                                            <i class="fa fa-external-link"/>
                                        </a>
                                    </div>
                                </t>
                            </td>
                            <td class="o_list_number"><t t-esc="r.quantity"/></td>
                            <td class="text-nowrap"><t t-esc="r.startdate"/></td>
                            <td class="text-nowrap"><t t-esc="r.enddate"/></td>
                            <td class="o_reco_description"><t t-out="formatDescription(r.description)"/></td>
                            <!-- APPROVE BUTTON -->
                            <td t-if="showApprove">
                                <button type="button" class="btn btn-sm btn-primary" t-on-click.prevent="() => this.approveRecommendation(r.id)">
                                    Approve
                                </button>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>

    <t t-name="frepple.RecommendationPagination">
        <t t-set="p" t-value="state.pagination[tab]"/>
        <t t-if="p and Math.ceil(p.total / p.pageSize) > 1">
            <div class="d-flex justify-content-center align-items-center gap-3 mt-2">
                <a href="#" t-if="p.page > 1" class="text-primary" t-on-click.prevent="() => this.prevPage(tab)">
                    <i class="fa fa-chevron-left"/>
                </a>
                <span class="fw-semibold">Page <t t-esc="p.page"/> / <t t-esc="Math.ceil(p.total / p.pageSize)"/></span>
                <a href="#" t-if="p.page &lt; Math.ceil(p.total / p.pageSize)" class="text-primary" t-on-click.prevent="() => this.nextPage(tab)">
                    <i class="fa fa-chevron-right"/>
                </a>
            </div>
        </t>
    </t>

</templates>
